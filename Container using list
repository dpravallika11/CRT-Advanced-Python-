class circle:
    def __init__ (self):
        x=int(input("Enter the value of radius:"))
        self.r=x
    def display(self):
        print("Area of circle is:",3.14*self.r**2)
a=int(input("Enter the number of circles:"))
l=[]
for i in range(a):
    c=circle()
    l.append(c)
    c.display()
    print("------------------------------")
